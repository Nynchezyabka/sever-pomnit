-- «Север помнит»: схема базы данных в Yandex Managed Service for YDB (Serverless).
-- Скопируйте весь текст и выполните один раз в консоли Yandex Cloud:
-- YDB → ваша база → Навигация → SQL-запрос → Вставить → Выполнить.

CREATE TABLE users (
  id Utf8 NOT NULL,
  email Utf8 NOT NULL,
  password_hash Utf8 NOT NULL,
  role Utf8 NOT NULL,
  created_at Utf8 NOT NULL,
  PRIMARY KEY (id),
  INDEX idx_users_email GLOBAL ON (email)
);

CREATE TABLE profiles (
  id Utf8 NOT NULL,
  full_name Utf8 NOT NULL,
  phone Utf8 NOT NULL,
  telegram Utf8 NOT NULL,
  oil Utf8 NOT NULL,
  tea Utf8 NOT NULL,
  pressure Utf8 NOT NULL,
  silence Bool NOT NULL,
  wishes Utf8 NOT NULL,
  offline Bool NOT NULL,
  created_at Utf8 NOT NULL,
  PRIMARY KEY (id)
);

CREATE TABLE subscriptions (
  id Utf8 NOT NULL,
  client_id Utf8 NOT NULL,
  title Utf8 NOT NULL,
  total_sessions Int32 NOT NULL,
  used_sessions Int32 NOT NULL,
  expires_on Utf8,
  created_at Utf8 NOT NULL,
  PRIMARY KEY (id),
  INDEX idx_subs_client GLOBAL ON (client_id)
);

CREATE TABLE visits (
  id Utf8 NOT NULL,
  client_id Utf8 NOT NULL,
  visited_on Utf8 NOT NULL,
  service Utf8 NOT NULL,
  comment Utf8 NOT NULL,
  created_at Utf8 NOT NULL,
  PRIMARY KEY (id),
  INDEX idx_visits_client GLOBAL ON (client_id)
);

CREATE TABLE client_notes (
  id Utf8 NOT NULL,
  client_id Utf8 NOT NULL,
  body Utf8 NOT NULL,
  created_at Utf8 NOT NULL,
  PRIMARY KEY (id),
  INDEX idx_notes_client GLOBAL ON (client_id)
);

CREATE TABLE booking_requests (
  id Utf8 NOT NULL,
  name Utf8 NOT NULL,
  contact Utf8 NOT NULL,
  service Utf8 NOT NULL,
  wish_time Utf8 NOT NULL,
  comment Utf8 NOT NULL,
  done Bool NOT NULL,
  created_at Utf8 NOT NULL,
  PRIMARY KEY (id),
  INDEX idx_booking_done GLOBAL ON (done)
);

CREATE TABLE gift_claims (
  id Utf8 NOT NULL,
  client_id Utf8 NOT NULL,
  gift Utf8 NOT NULL,
  claimed_on Utf8 NOT NULL,
  created_at Utf8 NOT NULL,
  PRIMARY KEY (id),
  INDEX idx_gifts_client GLOBAL ON (client_id)
);
